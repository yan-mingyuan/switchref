################################################################################
# External Repositories to Ignore
################################################################################
# Other local repos that should not be tracked here
projects/
llm_example/logs*

# Local temporary artifacts
paper_extract.txt

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Editor settings
.vscode/
.idea/
.spyderproject
.spyproject

# OS files
.DS_Store
*Zone.Identifier

# Local project scratch files
scratch/test.net
src/test_parsing.py
__my*
